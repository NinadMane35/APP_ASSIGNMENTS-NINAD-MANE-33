class Vehicle:
    def __init__(self, vehicle_number, brand, price):
        # Instance variables - separate copy for every object
        self.vehicle_number = vehicle_number
        self.brand = brand
        self.price = price
        self.category = self.get_category()   # category decided at creation time
 
    def get_category(self):
        """Categorize the vehicle based on its price."""
        if self.price >= 1500000:
            return "Luxury"
        else:
            return "Economy"
 
    def __str__(self):
        # Magic method - defines how the object is displayed with print()
        return (f"Vehicle No: {self.vehicle_number:<12} | Brand: {self.brand:<10} | "
                f"Price: Rs.{self.price:<10} | Category: {self.category}")
 
 
# ---------------------------------------------------
# Showroom class
# ---------------------------------------------------
class Showroom:
    def __init__(self, showroom_name):
        self.showroom_name = showroom_name
        self.vehicles = []          # instance variable holding list of Vehicle objects
 
    def add_vehicle(self, vehicle):
        """Add a Vehicle object to the showroom."""
        self.vehicles.append(vehicle)
        print(f"Added: {vehicle.brand} ({vehicle.vehicle_number}) to {self.showroom_name}")
 
    def display_all_vehicles(self):
        """Display details of all vehicles currently in the showroom."""
        print(f"\n----- Vehicles available at {self.showroom_name} -----")
        if not self.vehicles:
            print("No vehicles in the showroom yet.")
            return
        for index, vehicle in enumerate(self.vehicles, start=1):
            print(f"{index}. {vehicle}")
 
 
