class Mobile:
    def __init__(self, brand, model, price):
        self.brand = brand
        self.model = model
        self.price = price
        self.category = self.get_category()  

    def get_category(self):
        """Categorize the mobile based on its price."""
        if self.price >= 50000:
            return "Premium"
        elif self.price >= 20000:
            return "Mid-range"
        else:
            return "Budget"
 
    def __str__(self):
        return (f"Brand: {self.brand:<10} | Model: {self.model:<12} | "
                f"Price: Rs.{self.price:<8} | Category: {self.category}")
 
 

class Store:
    def __init__(self, store_name):
        self.store_name = store_name
        self.mobiles = []         
 
    def add_mobile(self, mobile):
        """Add a Mobile object to the store."""
        self.mobiles.append(mobile)
        print(f"Added: {mobile.brand} {mobile.model} to {self.store_name}")
 
    def display_all_mobiles(self):
        """Display details of all mobiles currently in the store."""
        print(f"\n----- Mobiles available at {self.store_name} -----")
        if not self.mobiles:
            print("No mobiles in the store yet.")
            return
        for index, mobile in enumerate(self.mobiles, start=1):
            print(f"{index}. {mobile}")
 
 
if __name__ == "__main__":
    my_store = Store("Ninad Mobile World")
 
    
    m1 = Mobile("Apple", "iPhone 15", 65000)
    m2 = Mobile("Samsung", "Galaxy M14", 15000)
    m3 = Mobile("OnePlus", "Nord CE4", 25000)
    m4 = Mobile("Xiaomi", "Redmi 12C", 9000)
    m5 = Mobile("Samsung", "Galaxy S24", 75000)
 
   
    my_store.add_mobile(m1)
    my_store.add_mobile(m2)
    my_store.add_mobile(m3)
    my_store.add_mobile(m4)
    my_store.add_mobile(m5)
 
    # Displaying all mobiles
    my_store.display_all_mobiles()
 
